# Десктоп-обёртка (Этап 7.5): сборки и Rust-артефакты не для git
builds/
desktop/target/
# gen/schemas — генерат tauri-build; Android-проект gen/android, наоборот,
# коммитится (каркас из `tauri android init`, правится руками) — его сборочные
# артефакты исключает сгенерированный gen/android/.gitignore (novagrid-058)
desktop/gen/schemas/

# Подписи release-APK — секрет, в git не попадает (duet-010)
desktop/gen/android/*.keystore
*.jks
promt.txt
promt_done.txt
CARDS/
